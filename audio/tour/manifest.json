{"voice":"kokoro/af_heart","clips":[{"i":0,"text":"Hi, I’m Sahnawaz — a full-stack developer and UI designer from Assam. Everything on this site is hand-coded, with no templates. Let me show you around in about a minute.","file":"step-1-7289a5e7.mp3","seconds":12.86,"bytes":64557,"words":[[0.625,0.925],[0.975,1.188],[1.188,2.0],[1.188,2.0],[2.075,2.2],[2.2,2.8],[2.8,3.413],[3.413,3.587],[3.587,4.025],[4.025,4.525],[4.525,4.675],[4.675,5.55],[5.712,6.225],[6.225,6.387],[6.387,6.562],[6.562,6.875],[6.875,7.025],[7.025,7.875],[7.975,8.15],[8.15,8.35],[8.35,9.3],[9.438,9.588],[9.588,9.75],[9.75,10.0],[10.0,10.15],[10.15,10.575],[10.575,10.725],[10.725,10.963],[10.963,11.025],[11.025,11.625]]},{"i":1,"text":"These are my live products: YojanaSahay, a free government-scheme finder used across India, StudyLens AI for students, and this website. Just below, live numbers come straight from each one.","file":"step-2-cc2b9b38.mp3","seconds":14.38,"bytes":72117,"words":[[0.65,0.925],[0.925,1.012],[1.012,1.175],[1.175,1.45],[1.45,2.35],[2.462,3.55],[3.688,3.825],[3.825,4.138],[4.138,4.962],[4.962,5.412],[5.412,5.688],[5.688,6.025],[6.025,6.675],[6.812,7.537],[7.537,8.0],[8.0,8.125],[8.125,8.7],[8.787,8.925],[8.925,9.125],[9.125,10.0],[10.175,10.45],[10.45,10.9],[11.012,11.35],[11.35,11.7],[11.7,11.9],[11.9,12.25],[12.25,12.387],[12.387,12.6],[12.6,13.15]]},{"i":2,"text":"Hiring? Paste your job post here. An AI compares it with my real work and tells you honestly where I match, and where I don’t.","file":"step-3-4a82586a.mp3","seconds":9.53,"bytes":47877,"words":[[0.65,1.15],[1.237,1.562],[1.562,1.675],[1.675,1.95],[1.95,2.263],[2.263,2.825],[2.988,3.163],[3.163,3.575],[3.575,4.025],[4.025,4.138],[4.138,4.263],[4.263,4.438],[4.438,4.725],[4.725,5.25],[5.25,5.4],[5.4,5.675],[5.675,5.85],[5.85,6.35],[6.35,6.512],[6.512,6.65],[6.65,7.15],[7.25,7.375],[7.375,7.537],[7.537,7.675],[7.675,8.3]]},{"i":3,"text":"This is how I ship. Every change goes through GitHub, is built automatically, and goes live in about a minute, with one-click rollback.","file":"step-4-52447b96.mp3","seconds":10.06,"bytes":50517,"words":[[0.625,0.8],[0.8,0.95],[0.95,1.2],[1.2,1.375],[1.375,2.05],[2.212,2.538],[2.538,3.0],[3.0,3.275],[3.275,3.475],[3.475,4.1],[4.2,4.35],[4.35,4.637],[4.637,5.575],[5.675,5.8],[5.8,6.15],[6.15,6.45],[6.45,6.562],[6.562,6.787],[6.787,6.85],[6.85,7.3],[7.4,7.587],[7.587,8.05],[8.05,8.825]]},{"i":4,"text":"And this is live telemetry, pulled straight from GitHub: what I shipped recently, my commit streak, and how healthy my projects are.","file":"step-5-0136cf30.mp3","seconds":9.48,"bytes":47637,"words":[[0.625,0.762],[0.762,0.925],[0.925,1.087],[1.087,1.425],[1.425,2.15],[2.25,2.55],[2.55,2.85],[2.85,3.025],[3.025,3.8],[3.95,4.087],[4.087,4.25],[4.25,4.575],[4.575,5.2],[5.275,5.425],[5.425,5.75],[5.75,6.3],[6.375,6.5],[6.5,6.675],[6.675,7.05],[7.05,7.225],[7.225,7.762],[7.762,8.25]]},{"i":5,"text":"Ready to talk? Message me, WhatsApp me, or request a call. I personally read every message. Thanks for taking the tour!","file":"step-6-70e764c6.mp3","seconds":9.29,"bytes":46677,"words":[[0.625,0.875],[0.875,1.0],[1.0,1.525],[1.638,2.05],[2.05,2.325],[2.425,2.9],[2.9,3.125],[3.2,3.325],[3.325,3.712],[3.712,3.775],[3.775,4.35],[4.45,4.612],[4.612,5.175],[5.175,5.462],[5.462,5.775],[5.775,6.5],[6.662,6.938],[6.938,7.05],[7.05,7.362],[7.362,7.45],[7.45,8.05]]}]}