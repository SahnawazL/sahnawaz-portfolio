13.075,13.562],[13.562,14.175]],"env":"","fps":25},{"i":8,"text":"Hiring? Paste your job post here. An AI compares it with my real work and tells you honestly where I match, and where I don’t.","file":"step-9-50694da4.mp3","seconds":8.95,"bytes":71853,"words":[[0.55,1.05],[1.137,1.462],[1.462,1.575],[1.575,1.85],[1.85,2.163],[2.163,2.725],[2.888,3.062],[3.062,3.475],[3.475,3.925],[3.925,4.037],[4.037,4.162],[4.162,4.338],[4.338,4.625],[4.625,5.15],[5.15,5.3],[5.3,5.575],[5.575,5.75],[5.75,6.25],[6.25,6.412],[6.412,6.55],[6.55,7.05],[7.15,7.275],[7.275,7.438],[7.438,7.575],[7.575,8.2]],"env":"000000000000004699999999997000459993069959989614489950147755300000000000009970999999999358985799855974870898868999996888731300000059945899955996089999920089979999899887764046730000999999988828876420100000000000000000000000","fps":25},{"i":9,"text":"Need something built? Every service flips open to show a clear starting price and exactly what’s included. Here’s website design, and here’s a portfolio site.","file":"step-10-eae97041.mp3","seconds":11.04,"bytes":88557,"words":[[0.525,0.725],[0.725,1.075],[1.075,1.65],[1.788,2.112],[2.112,2.587],[2.587,2.9],[2.9,3.25],[3.25,3.388],[3.388,3.625],[3.625,3.737],[3.737,4.075],[4.075,4.5],[4.5,5.088],[5.088,5.213],[5.213,5.8],[5.8,5.987],[5.987,6.9],[7.088,7.425],[7.425,7.85],[7.85,8.475],[8.575,8.7],[8.7,8.963],[8.963,9.025],[9.025,9.688],[9.688,10.275]],"env":"0000000000000399981299849998899985020000000000898599940899879850200798125699618887488888988960362899995108998999834887774000000008998876999813799889507986269978652000000000000000039999847999621997438856987888995000079976999879238952119999888740187641010000000000000000000000","fps":25},{"i":10,"text":"Already have a website? Run this free check. In about thirty seconds it shows your speed on a phone, your Google basics, and how your link looks on WhatsApp.","file":"step-11-22b5bdc1.mp3","seconds":10.46,"bytes":83949,"words":[[0.525,0.875],[0.875,1.038],[1.038,1.1],[1.1,1.85],[2.0,2