999589998498888988776000000007965789999429702699897787530210000000000000000000000","fps":25},{"i":8,"text":"Hiring? Paste your job post here. An AI compares it with my real work and tells you honestly where I match, and where I don’t.","file":"step-9-50694da4.mp3","seconds":8.95,"bytes":71853,"words":[[0.55,1.05],[1.137,1.462],[1.462,1.575],[1.575,1.85],[1.85,2.163],[2.163,2.725],[2.888,3.062],[3.062,3.475],[3.475,3.925],[3.925,4.037],[4.037,4.162],[4.162,4.338],[4.338,4.625],[4.625,5.15],[5.15,5.3],[5.3,5.575],[5.575,5.75],[5.75,6.25],[6.25,6.412],[6.412,6.55],[6.55,7.05],[7.15,7.275],[7.275,7.438],[7.438,7.575],[7.575,8.2]],"env":"000000000000004699999999997000459993069959989614489950147755300000000000009970999999999358985799855974870898868999996888731300000059945899955996089999920089979999899887764046730000999999988828876420100000000000000000000000","fps":25},{"i":9,"text":"Need something built? Every service here shows a clear starting price and exactly what’s included. Tap a card, or plan your project with AI.","file":"step-10-8d134b1c.mp3","seconds":10.18,"bytes":81645,"words":[[0.525,0.725],[0.725,1.075],[1.075,1.65],[1.788,2.138],[2.138,2.55],[2.55,2.837],[2.837,3.138],[3.138,3.237],[3.237,3.587],[3.587,4.025],[4.025,4.588],[4.588,4.713],[4.713,5.3],[5.3,5.487],[5.487,6.35],[6.513,6.763],[6.763,6.825],[6.825,7.325],[7.425,7.588],[7.588,7.862],[7.862,7.975],[7.975,8.438],[8.438,8.613],[8.613,9.425]],"env":"0000000000000499981199849998899984020000000000999689971099978960438888777899882850521999983009988898843788786000000079987859999503999798018984199977532000000000000026996781699988897500000996041999999814899868970488167899988876542000000000000000000000000","fps":25},{"i":10,"text":"Already have a website? Run this free check. In about thirty seconds it shows your speed on a phone, your Google basics, and how your link looks on WhatsApp.","file":"step-11-22b5bdc1.mp3","seconds":10.46,"bytes":83949,"words":[[0.525,0.875],[0.875,1.038],[1.038,1.1],[1.1,1.85],[2.