{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/chat",    "destination": "/api/chat.js" },
    { "source": "/api/resume",  "destination": "/api/resume.js" },
    { "source": "/share/:key",  "destination": "/api/share?key=:key" },
    { "source": "/share",       "destination": "/api/share" },
    { "source": "/(.*)",        "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800" }
      ]
    }
  ]
}
